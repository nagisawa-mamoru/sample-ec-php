#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# DATABASE
# docker-compose.yml の db サービスと合わせること
#--------------------------------------------------------------------

database.default.hostname = db
database.default.database = sample_ec
database.default.username = postgres
database.default.password = postgres
database.default.DBDriver = Postgre
database.default.port = 5432
database.default.charset = utf8

database.tests.hostname = db
database.tests.database = sample_ec_test
database.tests.username = postgres
database.tests.password = postgres
database.tests.DBDriver = Postgre
database.tests.port = 5432
database.tests.charset = utf8

#--------------------------------------------------------------------
# EXTERNAL API KEY (ダミー)
# 本番相当のシークレットは .env にのみ置き、リポジトリにはコミットしない、
# という権限モデルの説明用サンプル値。実際の外部サービスとは連携していない。
#--------------------------------------------------------------------

app.externalApiKey = dummy-api-key-please-change-me

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

encryption.key =
